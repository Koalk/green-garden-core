#!/bin/sh
# Enforces Conventional Commits. Enabled by scripts/setup-hooks.sh.
# Format: type(scope)!: subject   (scope and ! optional)

msg_file="$1"
subject=$(grep -v '^#' "$msg_file" | sed -n '1p')

# Allow merge and revert commits generated by git.
case "$subject" in
  "Merge "*|"Revert \""*) exit 0 ;;
esac

types="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"
pattern="^($types)(\([a-z0-9][a-z0-9._/-]*\))?!?: [^ ].*$"

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  echo "commit-msg: subject does not follow Conventional Commits." >&2
  echo "  expected: type(scope)?: subject" >&2
  echo "  types:    $types" >&2
  echo "  got:      $subject" >&2
  exit 1
fi

if [ "${#subject}" -gt 72 ]; then
  echo "commit-msg: subject is ${#subject} characters; keep it to 72 or fewer." >&2
  exit 1
fi

case "$subject" in
  *.) echo "commit-msg: no trailing full stop in the subject." >&2; exit 1 ;;
esac
