# Copy to .env and fill in. Never commit .env or real keys.
# Provider selection is configuration, not code. Names below are provisional.

# Weather provider: open-meteo | openweathermap | metoffice | visualcrossing | weatherapi | homeassistant
GREEN_GARDEN_WEATHER_PROVIDER=open-meteo
GREEN_GARDEN_OPENWEATHERMAP_API_KEY=
GREEN_GARDEN_METOFFICE_API_KEY=
GREEN_GARDEN_VISUALCROSSING_API_KEY=
GREEN_GARDEN_WEATHERAPI_API_KEY=
# Home Assistant weather entity
GREEN_GARDEN_HA_URL=
GREEN_GARDEN_HA_TOKEN=
GREEN_GARDEN_HA_WEATHER_ENTITY=

# Plant catalogue: openplantbook | manual
GREEN_GARDEN_CATALOGUE_PROVIDER=manual
# Token auth (simplest; sent as `Authorization: Token <token>`). The dev server reads it and proxies
# OpenPlantbook calls on /api/openplantbook/, so the browser never sees it.
GREEN_GARDEN_OPENPLANTBOOK_API_TOKEN=
# OAuth alternative:
GREEN_GARDEN_OPENPLANTBOOK_CLIENT_ID=
GREEN_GARDEN_OPENPLANTBOOK_CLIENT_SECRET=

# Optional plant identification (bring your own key): none | plantnet | plantid
GREEN_GARDEN_IDENTIFIER_PROVIDER=none
GREEN_GARDEN_PLANTNET_API_KEY=
GREEN_GARDEN_PLANTID_API_KEY=

# Optional self-hosted server (`mise run server`). Required to start; any long random string.
# Clients send it as `Authorization: Bearer <token>`.
GREEN_GARDEN_SERVER_TOKEN=
# Where the server keeps one JSON file per space (default ./data).
GREEN_GARDEN_SERVER_DATA_DIR=
# Password for the SMTP account used by email reminders (host, user, time are in the app's settings).
GREEN_GARDEN_SMTP_PASSWORD=

# Home Assistant bridge (`mise run ha-bridge`). Reads the core server above (same token) and
# publishes the plants to HA through your MQTT broker (HA's Mosquitto add-on or any broker HA uses).
# Address of the core server; default http://localhost:8080.
GREEN_GARDEN_SERVER_URL=
# Broker, e.g. mqtt://192.168.1.5:1883 or mqtts://broker.lan:8883 (required).
GREEN_GARDEN_HA_MQTT_URL=
GREEN_GARDEN_HA_MQTT_USER=
GREEN_GARDEN_HA_MQTT_PASSWORD=
# Which server dataset to show (default "default") and how often to re-read it, in seconds (default 300).
GREEN_GARDEN_HA_SPACE=
GREEN_GARDEN_HA_SYNC_SECONDS=

# Rain gauges. AEMET (Spain): free key from opendata.aemet.es, kept on the server only; without it
# the AEMET adapter is off. SEPA (Scotland): optional, the API answers without a key under a daily limit;
# the Base64 access key SEPA issues on request (hydrometry-requests@sepa.org.uk) raises the limit.
GREEN_GARDEN_AEMET_KEY=
GREEN_GARDEN_SEPA_KEY=
